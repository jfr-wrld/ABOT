# Optional cloud sync. Leave empty to run ABOT local-only (everything except sync still works).
# Full setup (database, Google sign-in, redirect URLs): docs/cloud-sync-setup.md
# URL is the project API URL (https://<project-ref>.supabase.co), not the dashboard URL.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional, web build only: Google Search Console "HTML tag" verification for the site's domain
# (needed for Google OAuth branding verification). Paste only the content value, not the whole tag.
GOOGLE_SITE_VERIFICATION=
